# Public site URL (used for metadata, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://thekaffe.az

# Google Maps JavaScript API key (optional; without it a styled iframe embed is used)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Resend (optional; without it form submissions are only logged on the server)
RESEND_API_KEY=
# Inbox that receives feedback & reservation emails
CONTACT_EMAIL_TO=
# Verified sender, e.g. "The Kaffe <hello@thekaffe.az>"
CONTACT_EMAIL_FROM=

# --- Masterclass receipts -------------------------------------------
# E-mail receipts to guests use RESEND_API_KEY + CONTACT_EMAIL_FROM above
# (the sender domain must be verified in Resend). CONTACT_EMAIL_TO gets a BCC.

# WhatsApp receipts — Meta WhatsApp Business Cloud API (optional)
# developers.facebook.com -> WhatsApp -> API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Name of an approved "Utility" message template with 7 body variables
# (see lib/receipt.ts). Create it in az, en and ru.
WHATSAPP_TEMPLATE=
